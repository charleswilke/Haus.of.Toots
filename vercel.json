{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/shop",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/flash-sheet-series",
      "destination": "/flash",
      "permanent": true
    },
    {
      "source": "/village-expansion-series",
      "destination": "/village",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/flash",
      "destination": "/flash-sheet-series"
    },
    {
      "source": "/village",
      "destination": "/village-expansion-series"
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
